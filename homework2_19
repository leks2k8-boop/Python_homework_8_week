import re
phone_pattern_1 = re.compile(r'(8 \d{3} \d{3}-\d{2}-\d{2})')
phone_pattern_2 = re.compile(r'([+]7 \d{3} \d{3}-\d{2}-\d{2})')
phone_pattern_3 = re.compile(r'(8 [(]\d{3}[)] \d{3}-\d{2}-\d{2})')
phone_pattern_4 = re.compile(r'([+]7 [(]\d{3}[)] \d{3}-\d{2}-\d{2})')

string = input()
if re.search(phone_pattern_1,string):
    a = re.findall(phone_pattern_1,string)
if re.search(phone_pattern_2,string):
    b = re.findall(phone_pattern_2, string)
if re.search(phone_pattern_3,string):
    c = re.findall(phone_pattern_3, string)
if re.search(phone_pattern_4,string):
    d = re.findall(phone_pattern_4, string)
print(a,b,c,d)
