import pathlib as pl

count = 0

def ddir(u,n):
    global count
    file_path = pl.Path(u)
    for i in file_path.iterdir():
        if i.is_dir():
            ddir(i,n)
        else:
            if str(n) == str(i.suffix):
                count += 1

u = input()
file_path = pl.Path(u)
n = input()
if file_path.is_dir():
    ddir(u,n)
    print(count)
else:
    print("Каталог не существует")
