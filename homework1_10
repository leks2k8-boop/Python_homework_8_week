import math
import random
import time
from functools import wraps


def time_it(stage_name):
    def decorator(func):
        @wraps(func)
        def wrapper(*args, **kwargs):
            start_time = time.perf_counter()
            result = func(*args, **kwargs)
            end_time = time.perf_counter()
            execution_time = end_time - start_time
            print(f"[{stage_name}] {execution_time:.6f} s")
            return result
        return wrapper
    return decorator


class DataSource:
    def get_data(self):
        raise NotImplementedError

    def _convert_to_float(self, raw_data):
        numeric_data = []
        for item in raw_data:
            try:
                numeric_data.append(float(item))
            except (ValueError, TypeError):
                pass
        return numeric_data


class ListDataSource(DataSource):
    def __init__(self, data_list):
        self.data_list = data_list

    @time_it("List Source")
    def get_data(self):
        return self._convert_to_float(self.data_list)


class FileDataSource(DataSource):
    def __init__(self, file_path):
        self.file_path = file_path

    @time_it("File Source")
    def get_data(self):
        try:
            with open(self.file_path, 'r', encoding='utf-8') as f:
                raw_data = f.read().split()
            return self._convert_to_float(raw_data)
        except FileNotFoundError:
            return []


class DataFilter:
    def __init__(self, data):
        self.data = data

    @time_it("Filter Negatives")
    def remove_negatives(self):
        self.data = [item for item in self.data if item >= 0]
        return self.data

    @time_it("Filter Range")
    def filter_by_range(self, min_val, max_val):
        self.data = [item for item in self.data if min_val <= item <= max_val]
        return self.data


class DataAnalyzer:
    def __init__(self, data):
        self.data = data

    @time_it("Analyzer")
    def analyze(self):
        if not self.data:
            return {"min": 0, "max": 0, "mean": 0, "std_dev": 0, "count": 0}

        min_val = min(self.data)
        max_val = max(self.data)
        mean_val = sum(self.data) / len(self.data)

        variance_sum = sum((x - mean_val) ** 2 for x in self.data)
        variance = variance_sum / len(self.data)
        std_dev = math.sqrt(variance)

        return {
            "min": min_val,
            "max": max_val,
            "mean": mean_val,
            "std_dev": std_dev,
            "count": len(self.data)
        }


class ReportGenerator:
    def __init__(self, metrics):
        self.metrics = metrics

    @time_it("Report Build")
    def generate_text_report(self):
        report = []
        report.append(f"Count:   {self.metrics['count']}")
        report.append(f"Min:     {self.metrics['min']:.4f}")
        report.append(f"Max:     {self.metrics['max']:.4f}")
        report.append(f"Mean:    {self.metrics['mean']:.4f}")
        report.append(f"StdDev:  {self.metrics['std_dev']:.4f}")
        return "\n".join(report)

    @time_it("Report Save")
    def save_to_file(self, file_path):
        report_text = self.generate_text_report()
        with open(file_path, 'w', encoding='utf-8') as f:
            f.write(report_text)


def generate_large_input_file(file_path, size=10000):
    with open(file_path, 'w', encoding='utf-8') as f:
        numbers = [str(random.uniform(-500, 1500)) for _ in range(size)]
        f.write(" ".join(numbers))


small_data = [10, -5, "20", 30, 150, "abc", -10.5]

source_small = ListDataSource(small_data)
data = source_small.get_data()

data_filter = DataFilter(data)
data = data_filter.remove_negatives()
data = data_filter.filter_by_range(0, 100)

analyzer = DataAnalyzer(data)
metrics = analyzer.analyze()

reporter = ReportGenerator(metrics)
print(reporter.generate_text_report())

input_filename = "large_input.txt"
output_filename = "final_report.txt"

generate_large_input_file(input_filename, size=12000)

source_large = FileDataSource(input_filename)
data_large = source_large.get_data()

filter_large = DataFilter(data_large)
data_large = filter_large.remove_negatives()
data_large = filter_large.filter_by_range(10, 1000)

analyzer_large = DataAnalyzer(data_large)
metrics_large = analyzer_large.analyze()

reporter_large = ReportGenerator(metrics_large)
reporter_large.save_to_file(output_filename)
