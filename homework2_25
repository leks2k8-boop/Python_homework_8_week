import re

logs = [
    "2026-09-24 10:15:32 INFO User 123 logged in",
    "2026-09-24 10:16:04 ERROR User 456 authentication failed",
    "2026-09-24 10:17:21 INFO User 123 opened page",
    "2026-09-24 10:18:45 WARNING User 789 too many requests",
    "2026-09-24 10:19:02 ERROR User 123 database connection failed",
]
a = []
b = []
data_pattern = re.compile(r'(\d{4}-\d{2}-\d{2})')
time_pattern = re.compile(r'(\d{2}:\d{2}:\d{2})')
lvl_pattern = re.compile(r'[A-Z]+')
ind_pattern = re.compile(r'(\d{3})')
massage_pattern = re.compile(r'[a-z_ ,.]+')
for log in logs:
    b.append(re.search(data_pattern, log).group())
    b.append(re.search(lvl_pattern, log).group())
    b.append(re.search(ind_pattern, log[::-1]).group()[::-1])
    b.append(re.search(massage_pattern, log[::-1]).group()[::-1][1:])
    b.append(re.search(time_pattern, log).group())
    a.append(b)
    b = []
for i in a:
    for j in i:
        print(j,end = ' ')
    print()
