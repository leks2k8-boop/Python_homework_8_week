import csv
import random
from datetime import datetime, timedelta

start_date = datetime(2006, 1, 30)
delta = timedelta(days=1)

Category = ['food','salary']
Type = ['income','expense','expense','expense']
rows = []
current_date = start_date
for i in range(6000):
    rcategory = random.choice(Category)
    rtype = random.choice(Type)
    if rtype == 'income':
        ramount = random.randint(10000,100000)
    else:
        ramount = random.randint(0,30000)
    if random.randint(0,1) == 0:
        date = current_date.strftime("%Y-%m-%d")
    else:
        current_date += delta
        date = current_date.strftime("%Y-%m-%d")
    rows.append([date,rcategory,ramount,rtype])

def creator(rows):
    hadder = ["date","category","amount","type"]
    with open('data.csv', 'w',encoding='utf-8',newline="") as csvfile:
        writer = csv.writer(csvfile)
        writer.writerow(hadder)
        writer.writerows(rows)

creator(rows)

