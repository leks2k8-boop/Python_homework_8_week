string = input()
count = 0
max_del = 0
STR = ''
while string != 'END':
    string = input()
    for i in string:
        if (i == 'a' or i == 'e' or i == 'i' or i == 'o' or i == 'u' or i == 'y' or i == 'A'
                or i == 'E' or i == 'I' or i == 'O' or i == 'U' or i == 'Y'):
            count += 1
    if count/len(string) > max_del:
        max_del = count/len(string)
        STR = string
    count = 0
print(STR)
