n = int(input())
a = [[0 for i in range(n)] for j in range(n)]
x = 0
y = 0
switch = 0
count = 0
for i in range(n*n):
    count += 1
    a[x][y] = count
    print(x,y,switch)
    if x == y or (x+y) == n-1:
        switch += 1
    if switch % 8 == 1:
        y += 1
    if switch % 8 == 2:
        x += 1
    if switch % 8 == 3:
        y -= 1
    if switch % 8 == 4:
        if a[x-1][y] != 0:
            y+=1
        else:
            x -= 1
    if switch % 8 == 5:
        x += 1
    if switch % 8 == 6:
        y += 1
    if switch % 8 == 7:
        x -= 1
    if switch % 8 == 0:
        if a[x][y-1] != 0:
            x+=1
        else:
            y -= 1
for i in a:
    for j in i:
        print(j,end=" ")
    print()
